{
  "info": {
    "name": "Upfund API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000/api" },
    { "key": "token", "value": "" },
    { "key": "test_email", "value": "test@upfund.com" },
    { "key": "test_password", "value": "password" },
    { "key": "creator_email", "value": "creator@upfund.com" },
    { "key": "creator_password", "value": "password" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.access_token) {",
                  "    pm.collectionVariables.set('token', res.access_token);",
                  "    console.log('Token saved:', res.access_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/login", "host": ["{{base_url}}"], "path": ["login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Landing Page",
      "item": [
        {
          "name": "Get Landing Page Data",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/landing-page", "host": ["{{base_url}}"], "path": ["landing-page"] }
          }
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "Get Projects List",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/projects?page=1",
              "host": ["{{base_url}}"],
              "path": ["projects"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "category", "value": "Teknologi", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Project Detail",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/projects/1", "host": ["{{base_url}}"], "path": ["projects", "1"] }
          }
        },
        {
          "name": "Get Project Comments",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/projects/1/comments?page=1",
              "host": ["{{base_url}}"],
              "path": ["projects", "1", "comments"],
              "query": [{ "key": "page", "value": "1" }]
            }
          }
        },
        {
          "name": "Get Project Posts",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/projects/1/posts?page=1",
              "host": ["{{base_url}}"],
              "path": ["projects", "1", "posts"],
              "query": [{ "key": "page", "value": "1" }]
            }
          }
        },
        {
          "name": "Create Project",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const res = pm.response.json();",
                  "pm.test('envelope success', () => pm.expect(res.status).to.eql('success'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{base_url}}/projects", "host": ["{{base_url}}"], "path": ["projects"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"EcoCharge Solar Pods\",\n  \"description\": \"Portable solar charging pods for off-grid communities.\",\n  \"video_pitch_url\": \"https://youtube.com/watch?v=ecocharge\",\n  \"cover_image_url\": \"https://cdn.upfund.test/ecocharge/cover.jpg\",\n  \"company_valuation\": 5000000,\n  \"funding_target\": 750000,\n  \"categories\": [1, 2],\n  \"shareholders\": [\n    { \"name\": \"Alice Founder\", \"owned_equity_percent\": 60 },\n    { \"name\": \"Bob Cofounder\", \"owned_equity_percent\": 25.5 }\n  ],\n  \"milestones\": [\n    { \"title\": \"Prototype\", \"description\": \"Build working prototype\", \"start_date\": \"2026-08-01\", \"end_date\": \"2026-09-01\", \"release_budget_percent\": 40 },\n    { \"title\": \"Pilot\", \"description\": \"Field pilot in 3 villages\", \"start_date\": \"2026-09-02\", \"end_date\": \"2026-11-01\", \"release_budget_percent\": 35 },\n    { \"title\": \"Scale\", \"description\": \"Manufacturing scale-up\", \"start_date\": \"2026-11-02\", \"end_date\": \"2027-02-01\", \"release_budget_percent\": 25 }\n  ]\n}"
            }
          }
        },
        {
          "name": "Create Project - Invalid (shareholder equity > 100%)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 422', () => pm.response.to.have.status(422));",
                  "const res = pm.response.json();",
                  "pm.test('shareholders error present', () => pm.expect(res.errors).to.have.property('shareholders'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{base_url}}/projects", "host": ["{{base_url}}"], "path": ["projects"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Bad Equity Co\",\n  \"description\": \"Shareholders sum to 110 percent, must be rejected.\",\n  \"video_pitch_url\": \"https://youtube.com/watch?v=badequity\",\n  \"cover_image_url\": \"https://cdn.upfund.test/badequity/cover.jpg\",\n  \"company_valuation\": 1000000,\n  \"funding_target\": 200000,\n  \"categories\": [1],\n  \"shareholders\": [\n    { \"name\": \"Greedy A\", \"owned_equity_percent\": 60 },\n    { \"name\": \"Greedy B\", \"owned_equity_percent\": 50 }\n  ],\n  \"milestones\": [\n    { \"title\": \"M1\", \"description\": \"obj\", \"start_date\": \"2026-08-01\", \"end_date\": \"2026-09-01\", \"release_budget_percent\": 100 }\n  ]\n}"
            }
          }
        },
        {
          "name": "Create Project - Invalid (milestone budget != 100%)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 422', () => pm.response.to.have.status(422));",
                  "const res = pm.response.json();",
                  "pm.test('milestones error present', () => pm.expect(res.errors).to.have.property('milestones'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{base_url}}/projects", "host": ["{{base_url}}"], "path": ["projects"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Bad Milestone Co\",\n  \"description\": \"Milestone budgets sum to 90 percent, must be rejected.\",\n  \"video_pitch_url\": \"https://youtube.com/watch?v=badmilestone\",\n  \"cover_image_url\": \"https://cdn.upfund.test/badmilestone/cover.jpg\",\n  \"company_valuation\": 1000000,\n  \"funding_target\": 200000,\n  \"categories\": [1],\n  \"shareholders\": [\n    { \"name\": \"Fair A\", \"owned_equity_percent\": 50 }\n  ],\n  \"milestones\": [\n    { \"title\": \"M1\", \"description\": \"obj1\", \"start_date\": \"2026-08-01\", \"end_date\": \"2026-09-01\", \"release_budget_percent\": 40 },\n    { \"title\": \"M2\", \"description\": \"obj2\", \"start_date\": \"2026-09-02\", \"end_date\": \"2026-10-01\", \"release_budget_percent\": 50 }\n  ]\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "Get Posts Feed",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/posts?page=1",
              "host": ["{{base_url}}"],
              "path": ["posts"],
              "query": [{ "key": "page", "value": "1" }]
            }
          }
        },
        {
          "name": "Get Post Detail",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/posts/1", "host": ["{{base_url}}"], "path": ["posts", "1"] }
          }
        },
        {
          "name": "Create Post",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{base_url}}/posts", "host": ["{{base_url}}"], "path": ["posts"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Update terbaru project EcoLoop!\",\n  \"image_url\": null,\n  \"project_url\": null,\n  \"category_titles\": [\"iot\", \"green tech\"]\n}"
            }
          }
        },
        {
          "name": "Toggle Like",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{base_url}}/interactions/like", "host": ["{{base_url}}"], "path": ["interactions", "like"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"target_id\": 1,\n  \"target_type\": \"post\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Comments",
      "item": [
        {
          "name": "Get Comments",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/comments?target_id=1&target_type=post",
              "host": ["{{base_url}}"],
              "path": ["comments"],
              "query": [
                { "key": "target_id", "value": "1" },
                { "key": "target_type", "value": "post" }
              ]
            }
          }
        },
        {
          "name": "Create Comment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{base_url}}/comments", "host": ["{{base_url}}"], "path": ["comments"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"target_id\": 1,\n  \"target_type\": \"post\",\n  \"comment\": \"Komentar keren!\",\n  \"project_url\": null\n}"
            }
          }
        },
        {
          "name": "Delete Comment",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/comments/1", "host": ["{{base_url}}"], "path": ["comments", "1"] }
          }
        }
      ]
    },
    {
      "name": "Profile",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/profile", "host": ["{{base_url}}"], "path": ["profile"] }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{base_url}}/profile", "host": ["{{base_url}}"], "path": ["profile"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"username\": \"testuser\",\n  \"email\": \"test@upfund.com\",\n  \"bio\": \"Investor di Upfund\",\n  \"avatar_url\": null,\n  \"bank_account_details\": \"Bank BCA - 1234567890\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "KYC",
      "item": [
        {
          "name": "Get KYC Status",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/kyc/status", "host": ["{{base_url}}"], "path": ["kyc", "status"] }
          }
        },
        {
          "name": "Submit KYC",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/kyc", "host": ["{{base_url}}"], "path": ["kyc"] },
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "company_document", "type": "file", "src": "" },
                { "key": "bank_document", "type": "file", "src": "" },
                { "key": "address", "value": "Jl. Contoh No. 1, Jakarta", "type": "text" }
              ]
            }
          }
        },
        {
          "name": "Admin Verify KYC",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{base_url}}/admin/kyc/1/verify", "host": ["{{base_url}}"], "path": ["admin", "kyc", "1", "verify"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"approved\",\n  \"rejection_reason\": null\n}"
            }
          }
        }
      ]
    }
  ]
}
